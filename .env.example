# Copy to `.env` for local dev. The app works fully OFFLINE without these —
# timing is stored locally in the browser. These are only needed to PUBLISH
# results to the public live page (Supabase).
#
# Reuse the same Supabase project as the main site if you like; the timing
# tables (supabase/schema.sql) are separate from the site's tables.
#
#   VITE_SUPABASE_URL       = Supabase project URL
#   VITE_SUPABASE_ANON_KEY  = the PUBLISHABLE key (sb_publishable_...)

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
